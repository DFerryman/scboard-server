# ============================================================
# hnreader local/deployment override config (sync-only)
#
# Load order (launcher.sh reads these automatically):
#   1) <project>\.env.local         <-- you are editing this one
#   2) <project>\server\.env.local  (loaded later, can override this file)
#
# Already in .gitignore (.env / .env.local / .env.*.local)
# Format: KEY=value, one per line; lines starting with # are comments;
# do not add quotes
#
# Sync-only mode: the server no longer listens on any HTTP port. All outbound
# traffic goes only via HNREADER_CLOUD_PUSH_URL -> the pushSync cloud function.
# The operator dashboard reads from the cloud-development database
# hn_dashboard_* collections.
# ============================================================

# ---------- AI enrichment ----------
# As long as provider is not "none" or empty, RealAiAgent is enabled. The
# actual routing is decided by the base_url of each object in the
# HNREADER_AI_CONFIGS array.
HNREADER_AI_PROVIDER=multi

# JSON array; failover follows array order. See server/README.md for examples.
# === !!! FILL ME IN !!! ===
# Single-provider example:
#   [{"name":"DeepSeek","api_key":"sk-xxx","model":"deepseek-v4-flash","base_url":"https://api.deepseek.com","balance_url":"https://api.deepseek.com/user/balance","timeout_seconds":120,"max_concurrent_requests":1,"max_output_tokens":8000}]
# Optional cost accounting fields are input_token_price_per_million and
# output_token_price_per_million. Without them, the dashboard reports
# unpriced_tokens so token volume is still visible but cost is intentionally
# not guessed from stale hard-coded prices.
# For a multi-provider (primary + backup) example, see the comment block at the
# top of server/launcher.sh.
HNREADER_AI_CONFIGS=

# ---------- Cloud sync (sync-only: the only outbound channel) ----------
# When disabled (empty / 0 / false), nothing happens after ingest finalize.
# When enabled, each completed ingest round builds the read model + dashboard
# projection -> POSTs them to the pushSync cloud function with an HMAC
# signature. A failure does not block the ingest main flow; see the
# server/cloud_sync_runs table and the hn_dashboard_cloud_sync_runs collection
# for details.
HNREADER_CLOUD_SYNC_ENABLED=
# === !!! FILL ME IN !!! HTTP trigger URL of the pushSync cloud function ===
# Must be https; loopback / RFC1918 / link-local / cloud metadata are not
# allowed -- validate_cloud_push_url will reject them.
HNREADER_CLOUD_PUSH_URL=
# === !!! FILL ME IN !!! 64-character hex shared secret (must match the cloud function PUSH_SECRET) ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HNREADER_CLOUD_PUSH_SECRET=
# Number of stories per batch (optional, default 50)
# HNREADER_CLOUD_PUSH_BATCH_SIZE=50
# Max writeBatch request body bytes (optional, default 80000; CloudBase text
# cloud-function requests are capped at 100KB)
# HNREADER_CLOUD_PUSH_MAX_BODY_BYTES=80000
# Per-HTTP-call timeout in seconds (optional, default 120)
# HNREADER_CLOUD_SYNC_TIMEOUT_SECONDS=120
# HNREADER_CLOUD_SYNC_RUN_RETENTION_DAYS=30

# ---------- 管理员告警邮件（163 邮箱）----------
HNREADER_ADMIN_EMAIL_ENABLED=true
HNREADER_ADMIN_EMAIL_TO=hacker_news@163.com
HNREADER_SMTP_HOST=smtp.163.com
# 163 on cloud servers should use SMTP-over-SSL 465; many providers restrict
# outbound SMTP 25 by default.
HNREADER_SMTP_PORT=465
HNREADER_SMTP_STARTTLS=false
HNREADER_SMTP_SSL=true
HNREADER_SMTP_USERNAME=hacker_news@163.com
HNREADER_SMTP_FROM=hacker_news@163.com
# === !!! FILL ME IN !!! 163 SMTP 客户端授权码（不是登录密码） ===
# 获取：163 网页邮箱 -> 设置 -> POP3/SMTP/IMAP -> 开启 IMAP/SMTP
#       -> 短信验证 -> 复制 16 位授权码
HNREADER_SMTP_PASSWORD=

# ============================================================
# The following keep the launcher defaults; uncomment to override as needed:
#   HNREADER_DB_PATH                 default server/data/hnreader.db
#   HNREADER_LOG_DIR                 default server/logs
#   HNREADER_DIGEST_TIMEZONE         default Asia/Shanghai
#   HNREADER_INGEST_INTERVAL_SECONDS default 1800
#   HNREADER_FEED_WINDOW_SIZE        default 100
#   HNREADER_ENRICH_*                default 8 worker / 16 session-story-limit / 3 batch_size
#
# Retired (after the sync-only change):
#   HNREADER_ADMIN_TOKEN          the server no longer has HTTP endpoints, so the token is useless
#   HNREADER_LOCAL_DASHBOARD_*    the local-debug dashboard has been removed
#   API_HOST / API_PORT           the launcher no longer starts uvicorn
#   MINIPROGRAM_BACKGROUND_INGEST the FastAPI embedded ingest loop has been retired
#   HNREADER_WECHAT_*             the mini program read path goes through the cloud function, no handshake anymore
#   HNREADER_JWT_* / SESSION_TTL_SECONDS / HNREADER_AUTH_*
#   HNREADER_TRUSTED_PROXY_HOSTS / HNREADER_AUTH_SESSION_RATE_LIMIT_*
# ============================================================
